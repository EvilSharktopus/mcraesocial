:621.89678955078125}},{"text":"Hi Hitler.","targetRectangle":{"y":-5.3454351425170898,"x":502.6357482910156,"width":370.87968749999993,"height":115}},{"text":"Hitler’s NAZI Party starts to win over voters with promises to:","targetRectangle":{"y":90.886863708496094,"x":400.18145751953125,"width":897.052734375,"height":33}},{"text":"revive  authoritarian rule through military law and order","targetRectangle":{"y":123.88686370849609,"x":400.18145751953125,"width":637.232421875,"height":53}},{"text":"abolish the Treaty of Versailles","targetRectangle":{"y":176.88686370849609,"x":400.18145751953125,"width":335.876953125,"height":53}},{"text":"promote and revive German nationalism (and unite all Germanic nations together)","targetRectangle":{"y":229.88686370849609,"x":400.18145751953125,"width":935.060546875,"height":53}},{"text":"revive the German military","targetRectangle":{"y":282.88686370849609,"x":400.18145751953125,"width":305.333984375,"height":53}},{"text":"offer protection of the Christian religion by the state","targetRectangle":{"y":335.88686370849609,"x":400.18145751953125,"width":599.34765625,"height":53}},{"text":"confiscate  all personal profits made off of WWI ","targetRectangle":{"y":388.88686370849609,"x":400.18145751953125,"width":551.673828125,"height":53}},{"text":"deny citizenship of anyone not of the German race","targetRectangle":{"y":441.88686370849609,"x":400.18145751953125,"width":575.326171875,"height":53}},{"text":"all citizens must work to be physically and spiritually pure","targetRectangle":{"y":494.88686370849609,"x":400.18145751953125,"width":649.60546875,"height":53}},{"text":"all citizens should have access to education and health care","targetRectangle":{"y":547.88686370849609,"x":400.18145751953125,"width":666.900390625,"height":53}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksToBounds":false,"rotation":0,"scale":1,"position":{"pointX":682.5,"pointY":384},"width":1365,"sublayerTransform":[1,0,