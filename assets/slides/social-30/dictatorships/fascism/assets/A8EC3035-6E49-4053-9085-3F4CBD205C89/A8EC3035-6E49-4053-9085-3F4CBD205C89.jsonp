":"buildIn","attributes":{"direction":0},"name":"apple:bc-appear","objectID":"F72D43B5-3543-4644-95DC-198A9601E1FF"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"Enabling A Dictator","targetRectangle":{"y":-28.012676239013672,"x":205.45393188476561,"width":818.93765624999992,"height":120}},{"text":"The Enabling Act:","targetRectangle":{"y":110.65464305877686,"x":8.5417919158935547,"width":233.771484375,"height":30}},{"text":"restricts personal freedoms (opinion, press, assembly)","targetRectangle":{"y":140.65464305877686,"x":96.746199607849121,"width":708.5634765625,"height":50}},{"text":"eliminates privacy of mail, telegrams, phone calls","targetRectangle":{"y":190.65464305877686,"x":96.746199607849121,"width":503.4833984375,"height":50}},{"text":"eliminates the need for search warrants","targetRectangle":{"y":240.65464305877686,"x":96.746199607849121,"width":417.57421875,"height":50}},{"text":"gives power to the Chancellor to make legislation \\u2028without the approval of the Reichstag","targetRectangle":{"y":290.65464305877686,"x":96.746199607849121,"width":537.1689453125,"height":80}},{"text":"bans all political parties other than the Nazi Party\\u2028","targetRectangle":{"y":370.65464305877686,"x":96.746199607849121,"width":669.8349609375,"height":50}},{"text":"Just like that... Hitler has created a dictatorship!","targetRectangle":{"y":450.65464305877686,"x":8.5417919158935547,"width":636.314453125,"height":50}},{"text":"June 30, 1934 – The Night of the Long Knives","targetRectangle":{"y":550.65464305877686,"x":8.5417919158935547,"width":475.4267578125,"height":50}},{"text":"All leaders of the SA (stormtroopers) are killed","targetRectangle":{"y":600.65464305877686,"x":8.5417919158935547,"width":500.271484375,"height":50}},{"text":"droppedImage.tiff","targetRectangle":{"y":93.324409484863281,"x":980.9327392578125,"width":329.34347534179688,"height":454.71481323242188}},{"text":"droppedImage.tiff","targetRectangle":{"y":511.99221801757812,"