# ── .env.local (add to .gitignore, add to Vercel env vars) ──────

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

VITE_GEMINI_API_KEY=your_gemini_api_key


# ── Firebase Firestore collections created automatically ─────────
#
# sessions/{SESSION_ID}
#   scenarios: [{ id, text, category, addedBy }]
#   phase: number (1–4, for future teacher control panel)
#
# rankings/{SESSION_ID}_{studentName}
#   studentName, sessionId, tiers: { gross/weird/bad/good: { S/A/B/C: [...scenarios] } }
#
# brackets/{SESSION_ID}_{studentName}
#   studentName, sessionId, category, bracket (full bracket object), lockedAt
#
# reflections/{SESSION_ID}_{studentName}
#   studentName, sessionId, hardest, best, worst, submittedAt


# ── Changing the session ─────────────────────────────────────────
#
# In WouldYouRatherBracket.jsx, line ~250:
#   const SESSION_ID = "wyr-session-001";
#
# Change this string for each new class/day. Old data stays in Firestore
# under the old session ID. You can also expose this as a URL param:
#
#   const SESSION_ID = new URLSearchParams(window.location.search).get("session") || "wyr-default";
#
# Then share the URL: https://yoursite.com/wyr?session=period3-may27


# ── 25-minute suggested timing ───────────────────────────────────
#
# Phase 1 — Brainstorm: 8 min  (whole class inputs together, projected on screen)
# Phase 2 — Ranking:    6 min  (individual, each student ranks their own)
# Phase 3 — Bracket:    7 min  (individual, vote through rounds)
# Phase 4 — Reflection: 4 min  (written, individual)


# ── Gemini API ───────────────────────────────────────────────────
#
# The app uses gemini-2.0-flash for duplicate detection.
# Get a key at: https://aistudio.google.com/app/apikey
# The Gemini call only fires when a student submits a scenario.
# Falls back to keyword matching if the API call fails.


# ── Deploying to Vercel ──────────────────────────────────────────
#
# 1. Push to GitHub
# 2. Import repo in Vercel
# 3. Add all VITE_* env vars in Vercel project settings
# 4. Deploy — Vercel auto-detects Vite


# ── Deploy Firestore rules ───────────────────────────────────────
#
# firebase deploy --only firestore:rules
