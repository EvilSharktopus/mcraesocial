rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is a teacher
    function isTeacher() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Allow read/write to the new settings collection
    match /settings/{doc} {
      allow read: if request.auth != null; // Students need to read to see what's open
      allow write: if isTeacher();         // Only teachers can toggle switches
    }

    // Make sure your users collection rule exists so the isTeacher() function works
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback: allow authenticated users to read/write everything else (plots, reflections, etc)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
