{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ngo.mcraesocial.com" }],
      "destination": "https://mcraesocial.com/ngo/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ngo/assets/:path*",
      "destination": "/ngo/assets/:path*"
    },
    {
      "source": "/ngo/:path*",
      "destination": "/ngo/index.html"
    },
    {
      "source": "/minerals/:path*",
      "destination": "/minerals/index.html"
    },
    {
      "source": "/workbooks/10-2/:path*",
      "destination": "https://mcraesocial.vercel.app/:path*"
    },
    {
      "source": "/workbooks/10-2",
      "destination": "https://mcraesocial.vercel.app/"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/movies/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/movies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}