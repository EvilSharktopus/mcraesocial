{
  "framework": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/workbooks/10-2/:path*",
      "destination": "https://10-2-iota.vercel.app/workbooks/10-2/:path*",
      "permanent": true
    },
    {
      "source": "/workbooks/10-2",
      "destination": "https://10-2-iota.vercel.app/workbooks/10-2",
      "permanent": true
    },
    {
      "source": "/workbooks",
      "destination": "https://10-2-iota.vercel.app/workbooks/10-2",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ngo/assets/(.*)",
      "destination": "/ngo/assets/$1"
    },
    {
      "source": "/ngo/((?!assets/).*)",
      "destination": "/ngo/index.html"
    },
    {
      "source": "/minerals/:path*",
      "destination": "/minerals/index.html"
    },
    {
      "source": "/gravity/(.*)",
      "destination": "/gravity/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/ngo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/movies/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/movies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
